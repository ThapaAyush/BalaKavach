{
  "manifest_version": 3,
  "name": "BalaKavach Browser Companion",
  "version": "0.2.1",
  "description": "Parent-managed website filtering companion for BalaKavach.",
  "minimum_chrome_version": "101",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://balakavach-be.onrender.com/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "BalaKavach Browser Companion",
    "default_popup": "popup.html"
  }
}

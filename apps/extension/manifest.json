{
  "manifest_version": 3,
  "name": "KidsGuard Local Website Filter",
  "version": "0.1.0",
  "description": "Apply a small, locally configured blocklist to website navigations.",
  "minimum_chrome_version": "101",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "KidsGuard local website filter",
    "default_popup": "popup.html"
  }
}

# KidsGuard Backend Environment Configuration
# Copy to .env for local development. Never commit .env or real credentials.

# Node environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server port (Render sets this dynamically via PORT)
PORT=5000

# MongoDB Atlas connection string (required for persistence; backend runs in degraded mode without it)
# Atlas requires 0.0.0.0/0 in Network Access for dynamic Render outbound IPs.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Allowed frontend origin for CORS and CSRF Origin validation (supports comma-separated origins)
CLIENT_ORIGIN=https://bala-kavach-fe.vercel.app,http://localhost:5173

# Parent session TTL in hours (default: 168 = 7 days)
AUTH_SESSION_TTL_HOURS=168

# Reverse proxy trust hops (default: 0 in dev/test, 1 in production for single reverse proxy like Render)
# Set to 1 when hosted behind a single reverse proxy (Render edge).
TRUST_PROXY=1

# Parent session cookie SameSite policy: 'strict', 'lax', or 'none' (use 'none' for Vercel <-> Render cross-domain hosting)
SESSION_COOKIE_SAME_SITE=none

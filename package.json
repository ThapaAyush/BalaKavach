{
  "name": "kidsguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/extension",
    "apps/android"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace @kidsguard/backend",
    "dev:api": "npm run dev --workspace @kidsguard/backend",
    "dev:frontend": "npm run dev --workspace @kidsguard/frontend",
    "dev:web": "npm run dev --workspace @kidsguard/frontend",
    "sync:downloads": "node scripts/sync-downloadables.mjs",
    "build:apk": "node scripts/sync-downloadables.mjs --build-apk",
    "build:all": "node scripts/sync-downloadables.mjs --build-apk && npm run build --workspace @kidsguard/frontend",
    "build": "npm run build --workspace @kidsguard/frontend",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
